{
    "name": "inertiajs/tonka-adapter",
    "description": "Inertia TONKA adapter",
    "type": "library",
    "require": {
        "php": ">=8.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Inertia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inertia\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../foundation" },
        { "type": "path", "url": "../routing" },
        { "type": "path", "url": "../psr" },
        { "type": "path", "url": "../validation" },
        { "type": "path", "url": "../console" },
        { "type": "path", "url": "../database" },
        { "type": "path", "url": "../metrics" }
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "clicalmani/foundation": "@dev",
        "clicalmani/routing": "@dev",
        "clicalmani/psr": "@dev",
        "clicalmani/validation": "@dev",
        "clicalmani/console": "@dev",
        "clicalmani/database": "@dev",
        "clicalmani/metrics": "@dev"
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "clicalmani",
            "email": "clicalmani@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": false
}
