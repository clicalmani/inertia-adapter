{
    "name": "inertiajs/tonka-adapter",
    "description": "Inertia TONKA adapter",
    "type": "library",
    "require": {
        "php": ">=8.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Inertia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inertia\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "clicalmani",
            "email": "clicalmani@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": false
}
